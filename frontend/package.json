    "@wailsio/runtime": "latest",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.186.1",
    "yaml": "^2.9.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.186.0",
