#!/bin/sh
set -eu
[ -z "${IPKG_INSTROOT:-}" ] || exit 0
[ "${1:-}" = upgrade ] && exit 0
if [ -f /etc/clashcube-guard/intent.json ] && ! jsonfilter -i /etc/clashcube-guard/intent.json -e '@.revision' >/dev/null 2>&1; then
    echo 'Cannot verify device policy intent; repair it before removing clashcube-guard.' >&2
    exit 1
fi
if [ -n "$(jsonfilter -i /etc/clashcube-guard/intent.json -e '@.policies[*].id' 2>/dev/null || true)" ]; then
    echo 'Release protected devices in ClashCube before removing clashcube-guard.' >&2
    exit 1
fi
/etc/init.d/clashcube-guard disable
