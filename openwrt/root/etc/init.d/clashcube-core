#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

boot() {
    mkdir -p /var/run/clashcube-core
    chmod 700 /var/run/clashcube-core
    # Consume once, so a later procd respawn preserves an explicit UI stop.
    touch /var/run/clashcube-core/boot
    start "$@"
}

start_service() {
    . /usr/share/clashcube/storage.sh
    clashcube_storage || return 1
    mkdir -p /var/run/clashcube-core
    chmod 700 /var/run/clashcube-core
    procd_open_instance
    procd_set_param command /usr/bin/clashcube-core
    procd_set_param env CLASHCUBE_HOME="$CLASHCUBE_HOME" CLASHCUBE_CORE_HOME="$CLASHCUBE_CORE_HOME" \
        CLASHCUBE_CACHE_HOME="$CLASHCUBE_CACHE_HOME" SAFE_PATHS="$SAFE_PATHS"
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 30
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_stopped() {
    # Management can be offline; only the core service owns firewall cleanup.
    . /usr/share/clashcube/storage.sh
    # Cleanup must work even when removable storage is missing.
    . /lib/functions.sh
    config_load clashcube
    config_get CLASHCUBE_HOME main data_dir /etc/clashcube
    CLASHCUBE_HOME="$CLASHCUBE_HOME" /usr/bin/clashcube-core firewall-stop
}
