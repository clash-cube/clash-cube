#!/bin/sh /etc/rc.common

START=96
STOP=9
USE_PROCD=1

start_service() {
    . /usr/share/clashcube/storage.sh
    clashcube_storage || return 1
    mkdir -p /var/run/clashcube
    chmod 700 /var/run/clashcube
    procd_open_instance
    procd_set_param command /usr/bin/clashcube-web -socket /var/run/clashcube/web.sock
    procd_set_param env CLASHCUBE_HOME="$CLASHCUBE_HOME" CLASHCUBE_CORE_HOME="$CLASHCUBE_CORE_HOME" \
        CLASHCUBE_CACHE_HOME="$CLASHCUBE_CACHE_HOME" SAFE_PATHS="$SAFE_PATHS"
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 30
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
